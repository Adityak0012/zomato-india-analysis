          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Recommendations for a new restaurant",
                    "textStyle": {
                      "fontSize": "22pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  List on online delivery from day one to build reviews and visibility quickly.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Prefer a mall or business-hub location (Cyber Hub, Khan Market, Connaught Place) where ratings run highest.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Consider an under-served, high-rated cuisine such as Mediterranean or Asian rather than another North Indian outlet.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Focus early effort on collecting reviews: well-reviewed restaurants attract more diners and more votes.",
                    "textStyle": {
                      "fontSize": "16pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Limitations: a 2019 snapshot, uneven city coverage, and correlations only. None of these findings prove cause and effect.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#D6E4FF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
