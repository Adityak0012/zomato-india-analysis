            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why compare inside Delhi NCR?",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#1B2A6B",
                      "fontFamily": "Segoe UI",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Outside Delhi NCR, Zomato listed only about 20 popular restaurants per city. All of them are rated, so they average 3.94 stars vs 3.28 in Delhi NCR.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#1C1C1C",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "That gap comes from how the data was collected, not from food quality. Fair comparisons are only possible within Delhi NCR.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#1C1C1C",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Inside Delhi NCR, malls and business hubs lead: Cyber Hub, DLF Mall of India, Sector 29 Gurgaon and Khan Market.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#1C1C1C",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
