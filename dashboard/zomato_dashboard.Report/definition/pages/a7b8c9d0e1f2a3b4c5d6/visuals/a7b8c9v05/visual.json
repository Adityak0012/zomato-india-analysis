                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  A single snapshot: no trends over time.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#1C1C1C",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Findings show correlation, not cause and effect.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#1C1C1C",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
