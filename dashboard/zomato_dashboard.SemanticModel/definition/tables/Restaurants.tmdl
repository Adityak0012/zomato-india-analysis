				        {"average_cost_for_two", type number}, {"has_table_booking", Int64.Type}, {"has_online_delivery", Int64.Type},
				        {"price_range", Int64.Type}, {"aggregate_rating", type number}, {"rating_text", type text}, {"votes", Int64.Type},
				        {"latitude", type number}, {"longitude", type number}, {"is_rated", Int64.Type}, {"region", type text},
				        {"primary_cuisine", type text}, {"cuisine_count", Int64.Type}, {"cost_bucket", type text}}, "en-US")
				in
				    Typed

