	column 'Vote Band' = SWITCH ( TRUE (), Restaurants[votes] <= 10, "Up to 10", Restaurants[votes] <= 50, "11-50", Restaurants[votes] <= 200, "51-200", Restaurants[votes] <= 1000, "201-1000", "1000+" )
